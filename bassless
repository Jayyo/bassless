#!/usr/bin/env bash
# bassless - practice tracks with one instrument muted, from a song file.
#
# Usage: bassless [options] <song file>
#   --stem S[,S]  stems to mute, one track each (default: bass); can be repeated
#                 bass | drums | vocals | other -> htdemucs_ft (4 stems)
#                 guitar | piano                -> htdemucs_6s (6 stems; Demucs' own
#                                                  README says the piano stem is weak)
#   --name NAME   output folder name (default: the song's file name)
#   --out DIR     parent folder (default: ~/Music/bassless)
#   --slow R      also render the muted and stem-only tracks at tempo R (0.25-4),
#                 pitch kept; needs ffmpeg built with librubberband
#   --shifts N    passed to Demucs (default 2)
#   --device D    cuda, cpu or mps (default: Demucs picks, the GPU if it sees one)
#   --ko          Korean file names (원곡, 베이스 없음, 베이스만, 느리게)
#   --fresh       delete what is already in the output folder and start over
#
# Output: <out>/<name>/
#   original.flac, no <stem>.flac, <stem> only.flac, slow <R>x/, .stems/
# The muted track is the original minus the separated stem, sample by sample, turned
# down just enough not to clip. Needs bash 4+, ffmpeg and Demucs 4.1.
set -euo pipefail

DEMUCS=${DEMUCS:-demucs}          # or e.g. DEMUCS=~/.venvs/demucs/bin/demucs
ROOT="$HOME/Music/bassless"
NAME=""; SLOW=""; SHIFTS=2; DEVICE=""; KO=0; FRESH=0
STEMS=(); POS=()

usage() { sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "bassless: $*" >&2; exit 1; }
bad() { echo "bassless: $*" >&2; exit 2; }
need() { [[ $# -ge 2 && -n "$2" ]] || bad "$1 needs a value"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --stem)   need "$@"; IFS=',' read -ra more <<< "$2"; STEMS+=("${more[@]}"); shift 2;;
    --name)   need "$@"; NAME="$2"; shift 2;;
    --out)    need "$@"; ROOT="$2"; shift 2;;
    --slow)   need "$@"; SLOW="$2"; shift 2;;
    --shifts) need "$@"; SHIFTS="$2"; shift 2;;
    --device) need "$@"; DEVICE="$2"; shift 2;;
    --ko)     KO=1; shift;;
    --fresh)  FRESH=1; shift;;
    -h|--help) usage; exit 0;;
    --) shift; POS+=("$@"); break;;
    -*) bad "unknown option: $1";;
    *) POS+=("$1"); shift;;
  esac
done
[[ ${#POS[@]} -eq 1 ]] || { usage >&2; exit 2; }
SRC="${POS[0]}"
[[ -f "$SRC" ]] || die "file not found: $SRC"
command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null || die "ffmpeg (with ffprobe) is not installed"

declare -A EN=([bass]=bass [drums]=drums [vocals]=vocals [other]=other [guitar]=guitar [piano]=piano)
declare -A KO_NAME=([bass]=베이스 [drums]=드럼 [vocals]=보컬 [other]=나머지 [guitar]=일렉기타 [piano]=피아노)
model_for() { case "$1" in guitar|piano) echo htdemucs_6s;; *) echo htdemucs_ft;; esac; }
stems_of() { case "$1" in htdemucs_6s) echo bass drums vocals other guitar piano;; *) echo bass drums vocals other;; esac; }

(( ${#STEMS[@]} )) || STEMS=(bass)
declare -A SEEN=(); UNIQUE=()
for s in "${STEMS[@]}"; do
  [[ -n "$s" ]] || bad "empty name in --stem"
  [[ -n "${EN[$s]:-}" ]] || bad "unknown stem '$s' (bass|drums|vocals|other|guitar|piano)"
  [[ -n "${SEEN[$s]:-}" ]] || { SEEN[$s]=1; UNIQUE+=("$s"); }
done
STEMS=("${UNIQUE[@]}")
[[ "$SHIFTS" =~ ^[0-9]+$ ]] || bad "--shifts must be a whole number"
[[ -z "$DEVICE" || "$DEVICE" =~ ^(cuda|cpu|mps)$ ]] || bad "--device must be cuda, cpu or mps"
if [[ -n "$SLOW" ]]; then
  [[ "$SLOW" =~ ^[0-9]*\.?[0-9]+$ ]] && LC_ALL=C awk -v r="$SLOW" 'BEGIN { exit !(r >= 0.25 && r <= 4) }' \
    || bad "--slow takes a tempo between 0.25 and 4, e.g. 0.8"
  # Read the list first: with pipefail, `ffmpeg | grep -q` fails when grep exits early.
  [[ "$(ffmpeg -hide_banner -filters 2>/dev/null)" == *rubberband* ]] || die "--slow needs ffmpeg built with librubberband"
fi

if (( KO )); then
  ORIG="원곡"; muted() { echo "${KO_NAME[$1]} 없음"; }; only() { echo "${KO_NAME[$1]}만"; }; slowdir() { echo "느리게 $1x"; }
else
  ORIG="original"; muted() { echo "no ${EN[$1]}"; }; only() { echo "${EN[$1]} only"; }; slowdir() { echo "slow $1x"; }
fi

if [[ -z "$NAME" ]]; then
  base=$(basename -- "$SRC"); NAME="${base%.*}"; [[ -n "$NAME" ]] || NAME="$base"
fi
[[ "$NAME" != */* && "$NAME" != "." && "$NAME" != ".." ]] || bad "--name can't contain '/'"
OUT="$ROOT/$NAME"; WORK="$OUT/.stems"; REF="$WORK/reference.wav"; ID_FILE="$WORK/source.sha256"

# ---- the output folder must belong to this song ---------------------------------
ID=$(sha256sum -- "$SRC" | cut -d' ' -f1)
LOCK="$WORK/.lock"
[[ ! -d "$LOCK" ]] || die "another bassless run is using $OUT (if none is, remove $LOCK)"
if [[ -e "$OUT" ]]; then
  if (( FRESH )); then
    [[ "$(realpath -- "$SRC")" != "$(realpath -m -- "$OUT")"/* ]] || die "the song is inside $OUT; --fresh would delete it"
    rm -rf -- "$OUT"
  elif [[ -f "$ID_FILE" ]]; then
    [[ "$(cat "$ID_FILE")" == "$ID" ]] || die "$OUT was made from a different file (use --name, or --fresh to replace it)"
  elif [[ -e "$REF" || -e "$OUT/$ORIG.flac" ]]; then
    die "$OUT has no record of which file it was made from (use --fresh to start over)"
  fi
fi
mkdir -p "$WORK"
mkdir "$LOCK" 2>/dev/null || die "another bassless run is using $OUT (if none is, remove $LOCK)"
trap 'rmdir -- "$LOCK" 2>/dev/null || true' EXIT
echo "$ID" > "$ID_FILE"

# Files are written next to their final name and renamed when complete, so an
# interrupted run never leaves a half-written file that a later run would reuse.
if [[ ! -f "$OUT/$ORIG.flac" ]]; then
  ffmpeg -loglevel error -y -i "$SRC" -map 0:a:0 -c:a flac -f flac "$OUT/$ORIG.flac.part"
  mv -f "$OUT/$ORIG.flac.part" "$OUT/$ORIG.flac"
fi
# Demucs works at 44.1 kHz stereo. Subtracting needs the original at exactly that
# rate and layout, sample-aligned with the stems, so Demucs separates this file.
if [[ ! -f "$REF" ]]; then
  # ffmpeg's -ac 2 turns mono into stereo 3 dB down per side; copy it at full level instead.
  layout=(-ac 2)
  [[ "$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$OUT/$ORIG.flac")" == 1 ]] \
    && layout=(-af "pan=stereo|c0=c0|c1=c0")
  # Float, so resampling a near-full-scale master can't clip it here.
  ffmpeg -loglevel error -y -i "$OUT/$ORIG.flac" -ar 44100 "${layout[@]}" -c:a pcm_f32le -f wav "$REF.part"
  mv -f "$REF.part" "$REF"
fi
# Demucs is handed the song 6 dB down. Its float32 writer clamps to +-1 whatever
# --clip-mode says, and stems of a loud master go past that (drums at 1.13 on one
# song). Demucs normalises its input level, so the stems come back at half scale
# (within about -75 dB of a full-level run on the song I checked) and are doubled.
# A stem that would peak above 2 in the song is still cut; that gets a warning.
HALF="$WORK/demucs-input.wav"
if [[ ! -f "$HALF" ]]; then
  ffmpeg -loglevel error -y -i "$REF" -af "volume=0.5" -c:a pcm_f32le -f wav "$HALF.part"
  mv -f "$HALF.part" "$HALF"
fi

peak_db() {  # peak_db <file>: peak in dB, measured in float
  local out v
  out=$(ffmpeg -hide_banner -nostats -i "$1" \
    -af "aformat=sample_fmts=flt,astats=measure_perchannel=none:measure_overall=Peak_level" -f null - 2>&1) \
    || die "ffmpeg failed while measuring a peak"
  v=$(sed -n 's/.*Peak level dB: \([^ ]*\).*/\1/p' <<< "$out" | tail -n 1)
  if [[ "$v" == "-inf" ]]; then echo "-inf"
  elif [[ "$v" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then echo "$v"
  else die "could not read the peak level from ffmpeg ('$v')"
  fi
}

# ---- separate (once per model; reused while the stems and settings match) -------
declare -A NEED=()
for s in "${STEMS[@]}"; do NEED[$(model_for "$s")]=1; done
for m in "${!NEED[@]}"; do
  settings="model=$m shifts=$SHIFTS float32 clip=none input=half"
  complete=1
  for st in $(stems_of "$m"); do [[ -f "$WORK/$m/$st.wav" ]] || complete=0; done
  if (( complete )) && [[ "$(cat "$WORK/$m/settings" 2>/dev/null)" == "$settings" ]]; then
    echo "[1] $m stems already there, reusing"
    continue
  fi
  echo "[1] separating with $m (shifts=$SHIFTS), about a minute per song on a GPU..."
  tmp="$WORK/.tmp-$m"; rm -rf -- "$tmp"; mkdir -p "$tmp"
  # float32 + no clipping: a 16-bit stem that Demucs had to rescale would no longer
  # subtract out of the original exactly.
  run=("$DEMUCS" -n "$m" --shifts "$SHIFTS" --float32 --clip-mode none -o "$tmp" --filename "{stem}.wav")
  [[ -n "$DEVICE" ]] && run+=(-d "$DEVICE")
  if ! "${run[@]}" "$HALF" > "$tmp/demucs.log" 2>&1; then
    tail -n 20 "$tmp/demucs.log" >&2
    rm -rf -- "$tmp"
    die "Demucs failed (last lines above)"
  fi
  for st in $(stems_of "$m"); do
    [[ -f "$tmp/$m/$st.wav" ]] || { rm -rf -- "$tmp"; die "Demucs finished but wrote no $st.wav"; }
    p=$(peak_db "$tmp/$m/$st.wav")
    [[ "$p" == "-inf" ]] || ! LC_ALL=C awk -v p="$p" 'BEGIN { exit !(p >= -0.001) }' \
      || echo "    warning: the $st stem hit full scale even at half level, so parts of it may be clipped"
  done
  echo "$settings" > "$tmp/$m/settings"
  rm -rf -- "${WORK:?}/$m"; mv "$tmp/$m" "$WORK/$m"; rm -rf -- "$tmp"
done

# ---- write the tracks ---------------------------------------------------------------
encode() {  # encode <out.flac> <filtergraph> <inputs...>: turned down only if it would clip
  local out=$1 graph=$2 peak gain args=() f tmp; shift 2
  for f in "$@"; do args+=(-i "$f"); done
  # Render once to float so the peak can go above full scale, then measure that file.
  # (volumedetect can't be used for this: it converts to 16-bit first and reports 0 dB.)
  tmp="$out.part.wav"
  ffmpeg -loglevel error -y "${args[@]}" -filter_complex "$graph,aformat=sample_fmts=flt" -c:a pcm_f32le -f wav "$tmp"
  peak=$(peak_db "$tmp")
  gain=0.00
  [[ "$peak" == "-inf" ]] || gain=$(LC_ALL=C awk -v p="$peak" 'BEGIN { printf "%.2f", (p > -0.1) ? -0.1 - p : 0 }')
  [[ "$gain" == "0.00" ]] || echo "    $(basename "$out" .flac): turned down ${gain#-} dB so it doesn't clip"
  ffmpeg -loglevel error -y -i "$tmp" -af "volume=${gain}dB" -sample_fmt s16 -c:a flac -f flac "$out.part"
  rm -f -- "$tmp"; mv -f "$out.part" "$out"
}

# Both files side by side as four channels, subtracted per channel (the stem doubled,
# see above). Float before pan, or the difference is computed in 16-bit and clips.
MINUS="[0][1]amerge=inputs=2,aformat=sample_fmts=flt,pan=stereo|c0=c0-2*c2|c1=c1-2*c3"
DOUBLE="aformat=sample_fmts=flt,volume=2"
for s in "${STEMS[@]}"; do
  STEM="$WORK/$(model_for "$s")/$s.wav"
  echo "[2] $(muted "$s") / $(only "$s")"
  encode "$OUT/$(muted "$s").flac" "$MINUS" "$REF" "$STEM"
  encode "$OUT/$(only "$s").flac" "$DOUBLE" "$STEM"
  if [[ -n "$SLOW" ]]; then
    SD="$OUT/$(slowdir "$SLOW")"; mkdir -p "$SD"
    # From the unattenuated signal, so the slow copy gets one gain of its own.
    encode "$SD/$(muted "$s").flac" "$MINUS,rubberband=tempo=$SLOW" "$REF" "$STEM"
    encode "$SD/$(only "$s").flac" "$DOUBLE,rubberband=tempo=$SLOW" "$STEM"
  fi
done

echo "done -> $OUT"
